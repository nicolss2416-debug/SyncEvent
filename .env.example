# Variables de entorno de referencia (no contiene secretos reales).
# Exportar antes de arrancar: set -a && source .env && set +a

DB_URL=jdbc:postgresql://localhost:5432/syncevent
DB_USER=syncevent
DB_PASSWORD=syncevent
SERVER_PORT=8080

# Generate a random 256-bit key and encode it as Base64; never commit the actual value.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_IDLE_TIMEOUT=PT30M
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
